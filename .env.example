# ==============================================
# LinkedIn Clone - Environment Variables Template
# Copy this file to .env and fill in your values
# ==============================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration (leave blank in dev if using in-memory MongoDB)
MONGO_URI=mongodb://localhost:27017/linkedin_clone

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_change_me_in_production

# Mailtrap Email Service Configuration
MAILTRAP_TOKEN=your_mailtrap_token_here
EMAIL_FROM=mailtrap@demomailtrap.com
EMAIL_FROM_NAME="LinkedIn Clone"

# Cloudinary Media Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# LiveKit Video Interview Configuration
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_URL=wss://your-project.livekit.cloud
